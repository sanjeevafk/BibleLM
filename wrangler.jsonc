{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "biblelm",
  "main": "worker/index.ts",
  "compatibility_date": "2025-02-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "NODE_ENV": "production",
    "ENABLE_NEURAL_RERANK": "1"
  }
}
