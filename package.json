{
  "name": "bible-lm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "npm run build:morphhb && npm run build:openhebrewbible && npm run build:translations && npm run build:opengnt && vite build",
    "deploy": "wrangler deploy",
    "preview": "vite preview",
    "build:morphhb": "ts-node --project tsconfig.scripts.json scripts/parse-morphhb.ts",
    "build:openhebrewbible": "ts-node --project tsconfig.scripts.json scripts/parse-openhebrewbible.ts",
    "build:translations": "ts-node --project tsconfig.scripts.json scripts/build-translations.ts",
    "build:opengnt": "ts-node --project tsconfig.scripts.json scripts/build-opengnt.ts",
    "build:graph-index": "ts-node --project tsconfig.scripts.json scripts/build-graph-index.ts",
    "build:hf-dataset": "ts-node --project tsconfig.scripts.json scripts/build-hf-dataset.ts",
    "build:wasm": "RUSTFLAGS='-C target-feature=+simd128' wasm-pack build rust/crates/biblelm-wasm --target nodejs --out-dir ../../pkg && node -e \"require('fs').rmSync('rust/pkg/.gitignore', { force: true })\"",
    "build:wasm:portable": "wasm-pack build rust/crates/biblelm-wasm --target nodejs --out-dir ../../pkg && node -e \"require('fs').rmSync('rust/pkg/.gitignore', { force: true })\"",
    "verify:independent": "ts-node --project tsconfig.scripts.json scripts/verification/independent-verification.ts",
    "verify:queries": "ts-node --project tsconfig.scripts.json scripts/verification/verify-real-queries.ts",
    "benchmark:sample": "ts-node --project tsconfig.scripts.json tests/benchmark/run-benchmarks.ts --mode sample",
    "benchmark:live": "BIBLELM_DISABLE_DB=1 BIBLELM_DISABLE_EXTERNAL_FALLBACK=1 BIBLELM_SILENT_TRANSLATION_WARNINGS=1 ts-node --project tsconfig.scripts.json tests/benchmark/run-benchmarks.ts --mode live",
    "benchmark:heldout": "BIBLELM_DISABLE_DB=1 BIBLELM_DISABLE_EXTERNAL_FALLBACK=1 BIBLELM_SILENT_TRANSLATION_WARNINGS=1 ts-node --project tsconfig.scripts.json tests/benchmark/run-benchmarks.ts --mode heldout",
    "benchmark:contract": "ts-node --project tsconfig.scripts.json tests/benchmark/check-route-contract.ts",
    "benchmark:regression": "ts-node --project tsconfig.scripts.json tests/benchmark/check-regressions.ts docs/benchmark/latest-report.json",
    "benchmark:flags": "ts-node --project tsconfig.scripts.json tests/benchmark/check-feature-flags.ts",
    "benchmark:ragas": "python3 scripts/benchmark.py --framework ragas",
    "benchmark:deepeval": "python3 scripts/benchmark.py --framework deepeval",
    "benchmark:py": "python3 scripts/benchmark.py --framework both",
    "benchmark:py:quick": "python3 scripts/benchmark.py --framework both --limit 5",
    "build:graph": "uv run code-review-graph build",
    "watch:graph": "uv run code-review-graph watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint --no-warn-ignored src components lib worker tests scripts *.ts *.mjs",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/groq": "^3.0.29",
    "@ai-sdk/react": "^3.0.118",
    "@radix-ui/react-slot": "^1.2.4",
    "@upstash/redis": "^1.37.0",
    "ai": "^6.0.116",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.7",
    "lucide-react": "^0.577.0",
    "pg": "^8.20.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "ts-node": "^10.9.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@eslint/eslintrc": "^3.3.5",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^22.17.0",
    "@types/pg": "^8.18.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.5",
    "dotenv": "^17.3.1",
    "eslint": "^9.39.4",
    "playwright": "^1.62.1",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.131.1",
    "zod": "^4.3.6"
  },
  "overrides": {
    "minimatch": "^10.2.4",
    "js-yaml": "^4.3.2"
  }
}
