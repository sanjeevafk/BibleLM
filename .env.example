# BibleLM environment variables
# Copy to .env.local and fill in real values (do not commit secrets).

# Required: Groq API Key (Primary LLM & Embeddings)
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: Groq embedding model override
# Defaults to nomic-embed-text-v1.5
GROQ_EMBEDDING_MODEL=

# Optional: Hugging Face token (canonical: HF_TOKEN; HUGGINGFACE_API_KEY also accepted)
# Get a token at https://huggingface.co/settings/tokens
HF_TOKEN=
# Alias honored by docker-compose / legacy scripts:
# HUGGINGFACE_API_KEY=

# Optional but recommended: Upstash Redis (cache + rate limiting)
# Create a free Redis database at https://console.upstash.com/
# For self-hosted docker compose, these point at the local REST gateway
# service (redis-rest), NOT stock Redis (RESP-only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: Postgres pgvector (semantic rerank / passage / cluster signals)
# Leave empty for lexical-only mode (BIBLELM_DISABLE_DB=1 forces it off).
POSTGRES_URL=
BIBLELM_DISABLE_DB=
BIBLELM_DISABLE_EXTERNAL_FALLBACK=

# Optional: cache TTLs (seconds) + prompt context budget (tokens)
# RESPONSE_CACHE_TTL=
# RETRIEVAL_CACHE_TTL=
# EMBEDDING_CACHE_TTL=
# PROMPT_CONTEXT_TOKEN_BUDGET=

# Optional: public app URL (used for CORS allowlist)
# NEXT_PUBLIC_APP_URL=

# Optional: Benchmark / evaluation
# Required in production: POST /api/evaluate returns 503 when empty in prod.
# Leave empty only for local dev (endpoint stays open + rate-limited).
EVAL_SECRET=

# Required for RAGAS and DeepEval LLM-judged metrics (they use OpenAI as judge by default)
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
